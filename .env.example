# Copia este archivo a .env y completa los valores reales.

# Seguridad
SECRET_KEY=change-this-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Base de datos PostgreSQL. Después de configurarla: alembic upgrade head
DATABASE_URL=postgresql+psycopg://closet:password@localhost:5432/closet

# Clima - OpenWeatherMap (https://openweathermap.org/api)
OPENWEATHER_API_KEY=

# IA para sugerencia de outfits: "rule_based" (por defecto, sin costo) o "claude" / "openai"
AI_PROVIDER=rule_based
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Carpeta local donde se guardan las fotos de las prendas
UPLOAD_DIR=./uploads

# Supabase Storage para las fotos en la nube (déjalo vacío para usar UPLOAD_DIR en local).
# SUPABASE_SERVICE_KEY: clave secreta (sb_secret_... o la legacy service_role). Nunca en la app móvil.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_BUCKET=garments
# Bucket PRIVADO para la foto de cuerpo completo de cada usuario.
SUPABASE_PRIVATE_BUCKET=body-photos

# remove.bg para quitar el fondo de las fotos (https://www.remove.bg/api).
REMOVEBG_API_KEY=

# Gemini para autocompletar los datos de una prenda (https://aistudio.google.com/apikey).
GEMINI_API_KEY=
# FASHN para la prueba virtual (https://app.fashn.ai/api). Cada prenda probada gasta 1 crédito.
FASHN_API_KEY=
# performance (más rápido), balanced o quality (mejor calidad, más lento).
FASHN_MODE=balanced
# Máximo de prendas (créditos) que cada usuario puede probar cada 24 horas.
TRY_ON_DAILY_LIMIT=10
